# Dependencies
node_modules/

# Build output
dist/

# OS files
.DS_Store

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Local env files
.env
.env.local
.env.*.local

# Local input data (metadata.csv + BBD_Path_Reports/...) - user-provided
# pathology data that should never be committed. Contains the fixtures
# for the metadata-CSV ingest path.
input_data/

# On-disk reference to the private-eye OCR project.
# Its Quick Read pipeline is ported into src/ocr/ (Phase 1); this
# directory stays as a source-of-truth reference but is not tracked here.
private-eye/

# Assets staged by scripts/prepare-build.mjs (regenerated on every build).
# Only public/coi-serviceworker.js is checked in.
public/ort/
public/models/
public/wllama-patched/
public/schemas/

# Model originals fetched by scripts/prepare-build.mjs and patched into
# public/models/. Regenerated on demand; the patched copy in public/ is
# what the app serves.
models/
