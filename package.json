{
  "name": "document-ocr-extractor",
  "version": "1.0.0",
  "description": "Document OCR Extractor - in-browser OCR + LLM pipeline for extracting structured data from scanned/PDF documents. A fusion of private-eye (OCR) and medical-report-information-extractor (extraction).",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-build.mjs",
    "predev": "node scripts/prepare-build.mjs",
    "dev": "vite",
    "build": "vite build",
    "fetch-models": "node scripts/fetch-models.mjs",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UK-Generations-Study/document-ocr-extractor.git"
  },
  "keywords": [],
  "author": "The Generations Study",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/UK-Generations-Study/document-ocr-extractor/issues"
  },
  "homepage": "https://github.com/UK-Generations-Study/document-ocr-extractor#readme",
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/js-yaml": "^4.0.9",
    "@wllama/wllama": "^3.5.0",
    "ajv": "^8.17.1",
    "fastest-levenshtein": "^1.0.16",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "js-yaml": "^5.4.1",
    "jsonld": "^9.0.0",
    "mdast-util-from-markdown": "^2.0.3",
