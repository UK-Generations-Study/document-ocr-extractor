    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "onnxruntime-common": "1.26.0",
    "onnxruntime-web": "1.26.0",
    "openai": "^6.15.0",
    "pdfjs-dist": "^4.10.38",
    "turndown": "^7.2.4",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
